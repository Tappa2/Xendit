const { initializeApp } = require("firebase-admin/app");
const { getFirestore, Timestamp } = require("firebase-admin/firestore");
const { onCall, HttpsError } = require("firebase-functions/v2/https");

initializeApp();

const db = getFirestore();
const COOLDOWN_MS = 5 * 60 * 60 * 1000;

exports.getVoucherStatus = onCall(async (request) => {
  if (!request.auth) {
    throw new HttpsError(
      "unauthenticated",
      "Mag-login muna para makita ang vouchers."
    );
  }

  const ref = db.collection("voucherAccounts").doc(request.auth.uid);
  const snap = await ref.get();

  if (!snap.exists || snap.data().newUserClaimed !== true) {
    return {
      claimablePercent: 20,
      voucherType: "NEW_USER_20",
      nextEligibleAt: null,
    };
  }

  const data = snap.data();
  const next = data.nextEligibleAt;

  if (!next || Timestamp.now().toMillis() >= next.toMillis()) {
    return {
      claimablePercent: 50,
      voucherType: "REGULAR_50",
      nextEligibleAt: next ? next.toMillis() : null,
    };
  }

  return {
    claimablePercent: 0,
    voucherType: null,
    nextEligibleAt: next.toMillis(),
  };
});

exports.claimVoucher = onCall(async (request) => {
  if (!request.auth) {
    throw new HttpsError(
      "unauthenticated",
      "Mag-login muna bago mag-claim."
    );
  }

  const uid = request.auth.uid;
  const voucherRef = db.collection("voucherAccounts").doc(uid);
  const historyRef = voucherRef.collection("history").doc();

  return db.runTransaction(async (tx) => {
    const snap = await tx.get(voucherRef);
    const data = snap.exists ? snap.data() : {};
    const now = Timestamp.now();

    let percent;
    let voucherType;

    if (data.newUserClaimed !== true) {
      percent = 20;
      voucherType = "NEW_USER_20";
    } else {
      const next = data.nextEligibleAt;

      if (!next || now.toMillis() < next.toMillis()) {
        throw new HttpsError(
          "failed-precondition",
          "Hindi pa eligible. Hintayin ang 5-hour cooldown."
        );
      }

      percent = 50;
      voucherType = "REGULAR_50";
    }

    const nextEligibleAt = Timestamp.fromMillis(
      now.toMillis() + COOLDOWN_MS
    );

    const claimCount = (data.claimCount || 0) + 1;

    tx.set(voucherRef, {
      newUserClaimed: true,
      lastVoucherType: voucherType,
      lastVoucherPercent: percent,
      lastClaimAt: now,
      nextEligibleAt,
      claimCount,
      updatedAt: now,
    }, { merge: true });

    tx.set(historyRef, {
      voucherType,
      percent,
      claimedAt: now,
      nextEligibleAt,
    });

    return {
      success: true,
      voucherType,
      percent,
      claimedAt: now.toMillis(),
      nextEligibleAt: nextEligibleAt.toMillis(),
    };
  });
});
